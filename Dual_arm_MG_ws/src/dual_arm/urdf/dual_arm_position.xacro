<?xml version="1.0" encoding="utf-8"?>
<robot name="dual_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="gazebo.xacro"/>

  <link name="world"/>

  <link name="link_base">
    <inertial>
      <origin
        xyz="-6.87583756092933E-17 0.040265400208447 0.243667266698083"
        rpy="0 0 0" />
      <mass value="3.37108689247961" />
      <inertia
        ixx="0.0237568206662565"
        ixy="8.78039880958513E-10"
        ixz="-9.4942237427685E-19"
        iyy="0.0249894879222251"
        iyz="-4.29674517106707E-18"
        izz="0.0258219973157558" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find dual_arm)/meshes/link_base.STL" />
      </geometry>
    </visual>
    
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find dual_arm)/meshes/link_base.STL" />
      </geometry>
    </collision>
  </link>
  
        
  <joint name="world_base" type="fixed">
      <parent link="world"/>
      <child link="link_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

