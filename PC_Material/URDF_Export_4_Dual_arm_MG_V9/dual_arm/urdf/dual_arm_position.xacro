<?xml version="1.0" encoding="utf-8"?>
<robot name="dual_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="world"/>

  <link name="link_base">
    <inertial>
      <origin
        xyz="0.03796 1.7173E-16 0.25423"
        rpy="0 0 0" />
      <mass value="3.5758" />
      <inertia
        ixx="0.025052"
        ixy="6.2851E-09"
